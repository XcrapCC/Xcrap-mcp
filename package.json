{
  "name": "@xcrapcc/mcp",
  "version": "1.3.0",
  "description": "MCP server for XCrap \u2014 Twitter/X tools for LLM agents: read posts, unroll threads, extract profiles and timelines, list media, no API key.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://xcrap.cc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XcrapCC/Xcrap-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/XcrapCC/Xcrap-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "twitter",
    "x",
    "tweet",
    "thread",
    "unroll",
    "scraper",
    "llm",
    "claude",
    "cursor",
    "ai"
  ],
  "bin": {
    "xcrap-mcp": "src/index.js"
  },
  "main": "src/index.js",
  "files": [
    "src",
    "README.md",
    "smithery.yaml"
  ],
  "scripts": {
    "start": "node src/index.js",
    "check": "node --check src/index.js",
    "inspect": "npx -y @modelcontextprotocol/inspector node src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "publishConfig": {
    "access": "public"
  }
}
